{
  "name": "wingrush",
  "version": "1.0.0",
  "description": "Wingsuit-Casual-Game (FHGR)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:single": "vite build --mode single --outDir dist-single",
    "build:deploy": "npm ci --include=dev && npm run build && npm --prefix server ci --omit=dev",
    "start": "node server/src/index.js",
    "db:init": "npm --prefix server run db:init",
    "db:check": "npm --prefix server run db:check",
    "db:local:setup": "npm --prefix server run db:local:setup",
    "db:local:start": "npm --prefix server run db:local:start",
    "db:local:stop": "npm --prefix server run db:local:stop",
    "db:local:status": "npm --prefix server run db:local:status"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
