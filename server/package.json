{
  "name": "wingrush-server",
  "version": "1.0.0",
  "description": "Wingrush Backend (Node.js + MariaDB)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node scripts/db-init.js",
    "db:check": "node scripts/db-check.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "mariadb": "^3.5.4"
  }
}
